# Copia este archivo con el nombre «.env.local» y escribe los valores. «.env.local» NO se sube a Git.
# Solo van aquí la dirección del proyecto y la clave PÚBLICA. La clave «service_role» o «secret» NUNCA va en ningún archivo.
#
# Modo de datos: vacío = todo en el teléfono (como hoy). «servidor» = inicio de sesión con Supabase.
NEXT_PUBLIC_DATOS=
# Supabase → Configuración del proyecto → Claves API → «Project URL»
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Configuración del proyecto → Claves API → la clave PÚBLICA («anon» o «publishable»)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
